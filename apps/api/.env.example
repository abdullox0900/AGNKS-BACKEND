# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL=postgresql://agnks:agnks@localhost:5432/agnks?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_DASHBOARD_ACCESS_TTL=15m
JWT_DASHBOARD_REFRESH_TTL=7d
JWT_CASHIER_ACCESS_TTL=15m
JWT_CASHIER_REFRESH_TTL=12h

# Telegram
TELEGRAM_CLIENT_BOT_TOKEN=
TELEGRAM_STAFF_BOT_TOKEN=
TELEGRAM_INIT_DATA_MAX_AGE_S=86400

# Storage (local disk)
STORAGE_ROOT=./storage
PHOTO_SIGNED_URL_TTL_S=300

# Soliq.uz receipt fetch
SOLIQ_FETCH_TIMEOUT_MS=4000
SOLIQ_FETCH_ENABLED=true

# Sentry
SENTRY_DSN=

# Misc
CORS_ORIGINS=http://localhost:5173,http://localhost:5175,http://localhost:5176
